<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>

<body>
    <%- include('partials/header') %>
    <main>
    <h1>EJS Practice</h1>
    <h2>Hello, <%= person.name %>
    </h2>
    <h3>
        <%= person.occupation %>
    </h3>
    <% if (['plumber', 'organist' , 'bagpiper' ].includes(person.occupation.toLowerCase())) { %>
        <p>You work with pipes!</p>
        <% } else { %>
            <p>That's an interesting job!</p>
        <% } %>

    <% if (['red', 'orange' , 'yellow', 'green', 'blue', 'indigo', 'violet' ].includes(person.favoriteColor.toLowerCase())) { %>
        <p>One of the colors of the rainbow!</p>
        <% } else { %>
            <p>That's a cool color!</p>
         <% } %>
    </main>
    <%- include('partials/footer') %>
</body>

</html>